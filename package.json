{
  "name": "@jevlint/cli",
  "version": "0.1.2",
  "license": "MIT",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "description": "Configurable semantic linting with Jev, including a magic-strings plugin.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/huntedman/JevLint.git"
  },
  "homepage": "https://jevlint.com",
  "bugs": {
    "url": "https://github.com/huntedman/JevLint/issues"
  },
  "packageManager": "pnpm@11.21.0",
  "type": "module",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "build": "esbuild src/index.ts plugins/magic-strings/index.ts --bundle --platform=node --format=esm --target=node22.18 --external:zod --outdir=dist --out-extension:.js=.mjs",
    "prepare": "npm run build",
    "start": "pnpm jevlint",
    "jevlint": "node src/index.ts",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "esbuild": "^0.28.2",
    "typescript": "~6.0.3",
    "vitest": "^4.1.10",
    "prettier": "^3.9.6"
  },
  "imports": {
    "#jevlint/*": "./src/*",
    "#jevlint-plugins/*": "./plugins/*"
  },
  "bin": {
    "jevlint": "dist/src/index.mjs"
  },
  "files": [
    "dist",
    "jevlint.config.example.json"
  ]
}
