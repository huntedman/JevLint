{
  "files": ["src", "examples"],
  "ignore": ["**/*.test.*", "**/*.d.ts"],
  "plugins": [
    {
      "path": "magic-strings",
      "files": ["src/**"],
      "ignore": ["**/*.test.ts"]
    },
    {
      "path": "descriptive-names",
      "files": ["examples/**", "src/services/**"],
      "ignore": ["**/*.generated.ts"]
    }
  ],
  "model": "jev-latest",
  "threshold": 0.8,
  "format": "text",
  "apiKeyEnv": "JEV_API_KEY",
  "timeoutMs": 30000,
  "maxFileBytes": 131072,
  "prettyPrint": true
}
